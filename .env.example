# Settings for the SOW Agent. Copy this file to ".env" and fill in your values.
# Keep the .env file private: anyone with your API key can spend your credit.

# 1) Your Claude API key (required). Create it in the Claude Console.
ANTHROPIC_API_KEY=

# 2) Model the agent uses. claude-opus-5-5 writes the best SOWs;
#    claude-sonnet-5-5 is faster and costs less per document.
SOW_MODEL=claude-opus-5-5

# 3) Let the agent search the web to check standards and regulations (1 = on, 0 = off).
#    Web searches are billed by the API as an extra.
SOW_WEB_SEARCH=1

# 4) Only for the phone (Telegram) bot. Leave empty if you only use the computer chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
